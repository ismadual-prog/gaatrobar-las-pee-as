:root{
  --bg:#faf6ef; --surface:#fff; --ink:#2a1d1a; --muted:#6f5f58;
  --accent:#8c2f2b; --gold:#b08a4a; --line:#e6dccd; --hero:#2a1512;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#1a1210;--surface:#251a17;--ink:#f3eadf;--muted:#b9a99d;--accent:#d9776f;--gold:#d2ad6b;--line:#3a2b26;--hero:#120b0a}
}
html{scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.7 "Lato","Helvetica Neue",Arial,sans-serif}
h1,h2,h3{font-family:"Playfair Display",Georgia,"Times New Roman",serif;font-weight:600;line-height:1.15;margin:0}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
.eyebrow{font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);margin:0 0 14px}
.btn{display:inline-block;padding:14px 30px;border:1px solid var(--gold);color:#f3eadf;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;font-size:.8rem;transition:.25s}
.btn:hover{background:var(--gold);color:#1a1210}
.btn.solid{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.solid:hover{filter:brightness(1.1);background:var(--accent);color:#fff}

.hero{background:radial-gradient(ellipse at 20% 0%,#5a231f 0%,transparent 60%),radial-gradient(ellipse at 90% 100%,#3b2a16 0%,transparent 55%),var(--hero);color:#f3eadf;padding-bottom:110px}
.nav{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 0;border-bottom:1px solid rgba(210,173,107,.25)}
.logo{font-family:"Playfair Display",Georgia,serif;font-size:1.25rem;letter-spacing:.06em;text-decoration:none}
.nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0}
.nav a{text-decoration:none;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;opacity:.85}
.nav a:hover{color:var(--gold);opacity:1}
.hero-body{text-align:center;padding:110px 0 20px}
.hero h1{font-size:clamp(2.8rem,9vw,5.6rem);letter-spacing:.01em}
.hero h1 em{color:var(--gold);font-style:italic}
.hero p.lead{max-width:560px;margin:22px auto 38px;color:#d9ccbf;font-size:1.1rem}
.rating{margin-top:42px;font-size:.9rem;color:#d9ccbf}
.rating strong{color:var(--gold);font-family:"Playfair Display",Georgia,serif;font-size:1.5rem;margin-right:8px}
.actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

section{padding:92px 0}
.sec-head{text-align:center;margin-bottom:52px}
.sec-head h2{font-size:clamp(2rem,5vw,3rem)}
.rule{width:56px;height:2px;background:var(--gold);margin:20px auto 0}
.about{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.about p{color:var(--muted);margin:0 0 18px}
.quote{border-left:2px solid var(--gold);padding:8px 0 8px 28px;font-family:"Playfair Display",Georgia,serif;font-size:1.6rem;line-height:1.4;font-style:italic}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:20px}
.card{background:var(--surface);border:1px solid var(--line);padding:34px 24px;text-align:center;transition:.25s}
.card:hover{transform:translateY(-4px);border-color:var(--gold)}
.card .ico{font-size:1.9rem;color:var(--gold);display:block;margin-bottom:12px}
.card h3{font-size:1.15rem;margin-bottom:6px}
.card p{margin:0;color:var(--muted);font-size:.92rem}
.band{background:var(--surface);border-block:1px solid var(--line)}
.visit{display:grid;grid-template-columns:1fr 1fr;gap:56px}
.hours{width:100%;border-collapse:collapse}
.hours td{padding:13px 0;border-bottom:1px solid var(--line)}
.hours td:last-child{text-align:right;color:var(--muted)}
.note{font-size:.82rem;color:var(--muted);margin-top:14px}
.contact p{margin:0 0 20px;color:var(--muted)}
.contact b{display:block;color:var(--ink);font-family:"Playfair Display",Georgia,serif;font-size:1.2rem;font-weight:600}
footer{background:var(--hero);color:#b9a99d;text-align:center;padding:36px 24px;font-size:.85rem}
footer strong{color:#f3eadf;font-family:"Playfair Display",Georgia,serif;font-size:1.1rem;letter-spacing:.06em}

@media (max-width:760px){
  .nav ul{display:none}
  .nav{justify-content:center}
  .about,.visit{grid-template-columns:1fr;gap:36px}
  section{padding:68px 0}
  .hero-body{padding-top:80px}
}